{
  "name": "work-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @work/api dev\" \"pnpm --filter @work/web dev\"",
    "build": "pnpm --filter @work/web build && pnpm --filter @work/api build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "tsx scripts/db-test.ts",
    "test:e2e": "playwright test",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "db:reset": "tsx scripts/db.ts reset",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "fake:feishu": "tsx scripts/fake-feishu.ts",
    "build:api": "tsx scripts/build-api.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:production": "tsx scripts/production-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vitest": "^3.2.0",
    "pg": "^8.16.0",
    "esbuild": "^0.28.2"
  }
}
