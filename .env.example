# 必填：Supabase 控制台 → Connect → Direct connection 或 Session pooler 的 PostgreSQL URI。
# 使用专门的开发项目；密码中的特殊字符需要 URL 编码。
# 推荐 Session pooler 的 5432 端口（支持 IPv4）；不使用 Transaction pooler 的 6543 端口。
# 按 Supabase 提供的 CA 配置证书验证，例如在连接串中使用 sslmode=verify-full。
SUPABASE_DB_URL=

# 必填：飞书开放平台中企业自建应用的凭据。
# 回调白名单：http://localhost:5173/auth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 首次使用建议填写：当前应用下管理员的 open_id（ou_...），不是 user_id / union_id。
BOOTSTRAP_PLATFORM_ADMIN_FEISHU_ID=

# 本地密钥由 pnpm setup / pnpm dev 自动生成并保存，不需要手动填写。
# 生产环境必须提供独立、至少 32 字符的随机密钥。
APP_SESSION_SECRET=

# 以下配置已有本地默认值，只在需要时启用。
# APP_BASE_URL=http://localhost:5173
# API_PORT=3001
# NODE_ENV=development
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# FEISHU_BASE_URL=  # 仅隔离测试使用，默认连接真实飞书；生产禁止设置。
