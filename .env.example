# 目标：国内站 final-pony-d7gnzgdj1b8ab4f99，上海 ap-shanghai（实例规格待核查）。
# 必填：CloudBase 国内站独享 PostgreSQL 的实际 TCP 连接串。
# 从目标环境控制台取得 host/port/database/user；不能用 EnvId 拼接地址。
# API 需能访问数据库私网（同地域/VPC 或已配置的私网接入）。共享 PG 不支持 TCP。
# 密码中的特殊字符需要 URL 编码；按控制台要求配置 TLS 并完整验证证书。
DATABASE_URL=
# 自定义 CA 文件路径（可选，启用 TLS 并验证证书；不提交数据库凭据/私钥）。
# DATABASE_CA_CERT_FILE=/run/secrets/cloudbase-postgres-ca.pem
# SUPABASE_DB_URL=  # 仅兼容旧部署；DATABASE_URL 非空时优先使用 DATABASE_URL。

# 必填：飞书开放平台中企业自建应用的凭据。
# 回调白名单：http://localhost:5173/auth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 首次使用建议填写：当前应用下管理员的 open_id（ou_...），不是 user_id / union_id。
BOOTSTRAP_PLATFORM_ADMIN_FEISHU_ID=

# 本地密钥由 pnpm setup / pnpm dev 自动生成并保存，不需要手动填写。
# 生产环境必须提供独立、至少 32 字符的随机密钥。
APP_SESSION_SECRET=

# 以下配置已有本地默认值，只在需要时启用。
# APP_BASE_URL=http://localhost:5173
# API_PORT=3001
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128  # 使用受信任反向代理时配置其来源地址
# NODE_ENV=development
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# FEISHU_BASE_URL=  # 仅隔离测试使用，默认连接真实飞书；生产禁止设置。
